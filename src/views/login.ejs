<%- include('partials/header') %>
<section class="fondo-login">
  <div class="contenedor login-grid">
    <div>
      <div class="marca-login">
        <img class="escudo" src="/img/cul-escudo.jpg" width="76" height="76" alt="Escudo de la Corporación Universitaria Latinoamericana">
        <div><strong>Uni<em>Solicita</em></strong><span>Corporación Universitaria Latinoamericana</span></div>
      </div>
      <span class="etiqueta-pill">Servicios universitarios en línea</span>
      <h1>Tus trámites,<em>sin filas ni vueltas.</em></h1>
      <p>Registra una solicitud, sigue su estado paso a paso y recibe un aviso cuando esté resuelta.</p>
      <ul class="puntos-lista">
        <li><%- icono('check') %> Seguimiento en tiempo real de cada solicitud</li>
        <li><%- icono('check') %> Historial completo e inalterable de movimientos</li>
        <li><%- icono('check') %> Notificaciones automáticas por cada cambio</li>
      </ul>
      <figure class="campus">
        <img src="/img/cul-campus.jpg" width="738" height="399" alt="Entrada principal de la Corporación Universitaria Latinoamericana">
        <figcaption>Tus trámites de la CUL, ahora en línea.</figcaption>
      </figure>
    </div>
    <div class="login-tarjeta">
      <h2>Iniciar sesión</h2>
      <p class="suave">Ingresa con tu correo institucional.</p>
      <% if (locals.error) { %><div class="aviso aviso-error" role="alert"><%= error %></div><% } %>
      <form method="post" action="/login" autocomplete="on" id="form-login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="campo">
          <label for="correo">Correo</label>
          <input type="email" id="correo" name="correo" value="<%= correo %>" required autofocus autocomplete="username" placeholder="nombre@universidad.edu">
        </div>
        <div class="campo">
          <label for="contrasena">Contraseña</label>
          <input type="password" id="contrasena" name="contrasena" required autocomplete="current-password" placeholder="••••••••">
        </div>
        <button class="btn btn-oro btn-ancho" type="submit">Entrar <%- icono('flecha') %></button>
      </form>
      <% if (cuentasDemo.length) { %>
      <div class="demo">
        <p>Cuentas de demostración (contraseña <strong>Demo1234*</strong>):</p>
        <% cuentasDemo.forEach((c) => { %>
          <button type="button" data-demo="<%= c.correo %>"><%= c.rol %> <span><%= c.correo %></span></button>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
