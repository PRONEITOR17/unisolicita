<%- include('../partials/header') %>
<div class="contenedor pagina">
  <div class="pagina-cabecera">
    <div><span class="etiqueta-pill oscura">Administración</span><h1>Usuarios</h1></div>
    <a class="btn btn-oro" href="/usuarios/nuevo"><%- icono('plus') %> Nuevo usuario</a>
  </div>
  <%- include('../partials/ayuda-pagina', { pagina: 'usuarios' }) %>
  <div class="tarjeta">
    <form method="get" action="/usuarios" class="filtros">
      <div class="campo"><label for="rol">Rol</label>
        <select id="rol" name="rol"><option value="">Todos</option>
          <% roles.forEach((r) => { %><option value="<%= r.nombre %>" <%= rolFiltro === r.nombre ? 'selected' : '' %>><%= etiquetaRol(r.nombre) %></option><% }) %>
        </select></div>
      <div class="botones"><button class="btn btn-sm" type="submit">Filtrar</button></div>
    </form>
    <div class="tabla-caja">
      <table class="tabla">
        <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        <% usuarios.forEach((u) => { %>
          <tr>
            <td><strong><%= u.nombre %></strong></td>
            <td><%= u.correo %></td>
            <td><span class="badge rol-chip"><%= etiquetaRol(u.rol) %></span></td>
            <td><span class="badge <%= u.activo ? 'estado-resuelta' : 'inactivo' %>"><%= u.activo ? 'Activo' : 'Inactivo' %></span></td>
            <td><div class="acciones">
              <a class="btn btn-borde btn-sm" href="/usuarios/<%= u.id %>/editar">Editar</a>
              <% if (u.id !== usuario.id) { %>
              <form method="post" action="/usuarios/<%= u.id %>/activo" <%- u.activo ? 'data-confirmar="¿Desactivar este usuario? Su historial se conserva."' : '' %>>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="activo" value="<%= u.activo ? 'false' : 'true' %>">
                <button class="btn btn-sm <%= u.activo ? 'btn-peligro' : 'btn-verde' %>" type="submit"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
              </form>
              <% } %>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
