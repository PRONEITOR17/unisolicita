{
  "name": "unisolicita",
  "version": "1.0.0",
  "description": "UniSolicita: sistema de gestión de servicios y solicitudes universitarias",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/migrate.js",
    "seed:demo": "node src/db/seedDemo.js",
    "crear-admin": "node scripts/crearAdmin.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint src tests scripts",
    "metricas": "node scripts/metricas.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/db/migrate.js",
      "!src/db/seedDemo.js"
    ],
    "coverageReporters": [
      "text-summary",
      "text"
    ],
    "testTimeout": 30000
  }
}
