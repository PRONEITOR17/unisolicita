# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env a GitHub ni pegues estas claves en un chat (ya está en .gitignore).

PORT=3000

# Dirección pública del sistema. Se usa en los enlaces de los correos.
# En producción: https://tu-sistema.onrender.com (o tu dominio)
APP_URL=http://localhost:3000

# ---------------- Base de datos ----------------
# Déjalo vacío para usar PostgreSQL embebido (PGlite), sin instalar nada (solo para tu computador).
# Para PostgreSQL real (local, Neon, Supabase…) pon la cadena de conexión:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/unisolicita
DATABASE_URL=
# Pon true si tu proveedor exige SSL (Neon, Supabase)
PGSSL=false

# ---------------- Seguridad ----------------
# Obligatorio en producción: una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
# true detrás de un proxy (Render, Railway…). En NODE_ENV=production ya es true por defecto.
# TRUST_PROXY=true

# ---------------- Modo de uso ----------------
# true: muestra las cuentas de demostración en el inicio de sesión y las crea en una base nueva.
# false: sistema real, sin cuentas de ejemplo. (Si no lo defines, es true en desarrollo y false en producción.)
SHOW_DEMO=true

# Primer administrador real: se crea al iniciar si todavía no hay ninguno activo.
# Después entra, ve a «Usuarios» y crea a los demás con sus correos reales.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_CLAVE=

# ---------------- Correos de notificación ----------------
# Si SMTP_HOST está vacío, el sistema funciona igual pero solo con avisos dentro de la página.
# Ejemplo con Gmail (cuenta con verificación en dos pasos y una «contraseña de aplicación»):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=la-contraseña-de-aplicación-de-16-letras
# SMTP_FROM=UniSolicita <tu.correo@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Correo de soporte que ven las personas en la ayuda y en el pie de página
SOPORTE_CORREO=soporte@unisolicita.edu
